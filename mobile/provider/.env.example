# Provider App environment variables — TEMPLATE ONLY
# Copy to .env and fill in your own values. Never commit .env.
# Do NOT put secret keys here: anything in a mobile app can be extracted.
# All secret API calls (AI, S3, etc.) go through the backend.
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app.
# Backend URL as seen from where the app runs:
#   Browser / iOS simulator: http://localhost:5000/api
#   Android emulator:        http://10.0.2.2:5000/api
#   Physical phone:          http://<your-computer-LAN-IP>:5000/api

EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api
