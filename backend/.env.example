# ==========================================================
# Backend environment variables — TEMPLATE ONLY
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.
# ==========================================================

# ---------- Server ----------
NODE_ENV=development
PORT=5000

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skilled_services_dev
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ---------- Authentication (JWT) ----------
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# ---------- CORS ----------
# Comma-separated list of allowed client origins
CORS_ORIGINS=http://localhost:3000

# ---------- AI (LLM + Vision) ----------
AI_API_KEY=your_llm_api_key
AI_MODEL=your_llm_model_name
VISION_AI_API_KEY=your_vision_api_key
VISION_AI_MODEL=your_vision_model_name

# ---------- Maps ----------
MAPS_API_KEY=your_maps_api_key

# ---------- Firebase Cloud Messaging ----------
# Path to the service account JSON file (keep that file OUT of Git)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# ---------- AWS S3 ----------
AWS_REGION=your_aws_region
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_bucket_name
